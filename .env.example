# Copy to .env (or export in your shell) and fill in what you use. Never commit .env.
# Every name is documented in docs/CONTRACT.md. Paths default to repo-relative folders; run from the repo root.

# Stoa dataset root (holds questions.jsonl and data/); only needed for evals and the dataset browser
STOA_DATA=
# Local state: caches, eval splits, optional precomputed artifacts (default: .stoa)
JUNCTION_SHARED=
# Cache for page renders of read-only inputs (default ~/.cache/stoa; writable inputs get them alongside)
STOA_CACHE=
# API-only mode without a local GPU: api (see README); seconds a model step waits for a restarting local server
STOA_MODE=
LLM_RESTART_WAIT=

# Local OpenAI-compatible model server (vLLM, see serving/start.sh); default http://127.0.0.1:8001/v1
LLM_BASE_URL=
# Optional second local server (larger text model), and Bearer tokens for authenticated endpoints
LLM2_BASE_URL=
LLM_API_KEY=
LLM2_API_KEY=

# Hosted models (optional): Google Gemini (escalation for hard uploads), NVIDIA API (Nemotron second opinion)
GEMINI_API_KEY=
GEMINI_MAX_CALLS_PER_DAY=
NVIDIA_API_KEY=
# 1 = escalate unsure answers to Gemini / verify with Nemotron after the cascade (API default); evals set 0
STOA_GEMINI_ESCALATE=
STOA_VERIFY=

# Optional pretrained CubiCasa5K detector (weights CC BY-NC 4.0, not in this repo) and a Python with torch
CC5K_WEIGHTS=
CC5K_PYTHON=
